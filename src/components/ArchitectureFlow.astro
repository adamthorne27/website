---
type Props = {
	title: string;
	stages: string[];
};

const { title, stages } = Astro.props;
---

<div role="group" aria-label={title}>
	<ol class="architecture">
		{stages.map((stage, index) => (
			<>
				<li>{stage}</li>
				{index < stages.length - 1 && <span class="architecture__arrow" aria-hidden="true"></span>}
			</>
		))}
	</ol>
</div>
