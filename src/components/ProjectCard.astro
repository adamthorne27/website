---
import type { Project } from '../data/portfolio';

type Props = {
	project: Project;
};

const { project } = Astro.props;
---

<article class="project-card">
	<p class="eyebrow">{project.category}</p>
	<h3>{project.title}</h3>
	<p class="project-card__summary">{project.summary}</p>
	<div class="card-metrics" aria-label={`${project.title} key metrics`}>
		{project.metrics.slice(0, 2).map((metric) => (
			<p><strong>{metric.value}</strong><span>{metric.label}</span></p>
		))}
	</div>
	<p class="project-card__stack">{project.stack.join(' · ')}</p>
	<a class="text-link" href={`/projects/${project.slug}/`}>View project</a>
</article>
